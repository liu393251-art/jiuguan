{
  "name": "合理化世界·渲染归一",
  "rules": [
    {
      "scriptName": "数值·状态开头",
      "findRegex": "<[ \\t]*状态[ \\t]*>",
      "replaceString": "\n[[状态]]\n",
      "flags": "g",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "数值·状态结尾",
      "findRegex": "<[ \\t]*/[ \\t]*状态[ \\t]*>",
      "replaceString": "\n[[/状态]]\n",
      "flags": "g",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "数值·女·沈昭宁",
      "findRegex": "^[ \\t]*女[ \\t]*沈昭宁[^\\n]*?好感[^\\n]*?(\\d{1,3})[^\\n]*?欲望[^\\n]*?(\\d{1,3})[^\\n]*?堕落[^\\n]*?(\\d{1,3})[^\\n]*$",
      "replaceString": "沈昭宁｜女｜28｜昭衡律所合伙人\n好感度：$1\n欲望值：$2\n堕落度：$3",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "数值·女·苏念",
      "findRegex": "^[ \\t]*女[ \\t]*苏念[^\\n]*?好感[^\\n]*?(\\d{1,3})[^\\n]*?欲望[^\\n]*?(\\d{1,3})[^\\n]*?堕落[^\\n]*?(\\d{1,3})[^\\n]*$",
      "replaceString": "苏念｜女｜20｜临江大学新闻系大二\n好感度：$1\n欲望值：$2\n堕落度：$3",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "数值·女·温以宁",
      "findRegex": "^[ \\t]*女[ \\t]*温以宁[^\\n]*?好感[^\\n]*?(\\d{1,3})[^\\n]*?欲望[^\\n]*?(\\d{1,3})[^\\n]*?堕落[^\\n]*?(\\d{1,3})[^\\n]*$",
      "replaceString": "温以宁｜女｜24｜临江大学图书馆古籍部\n好感度：$1\n欲望值：$2\n堕落度：$3",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "数值·男·周牧",
      "findRegex": "^[ \\t]*男[ \\t]*周牧[^\\n]*?仇恨[^\\n]*?(\\d{1,3})[^\\n]*$",
      "replaceString": "周牧｜男｜26｜市政设计院结构工程师\n仇恨值：$1",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "数值·男·程越",
      "findRegex": "^[ \\t]*男[ \\t]*程越[^\\n]*?仇恨[^\\n]*?(\\d{1,3})[^\\n]*$",
      "replaceString": "程越｜男｜31｜昭衡律所合伙人\n仇恨值：$1",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "格式·动作行去括号",
      "findRegex": "^[ \\t]*[（(]([^）)\\n]{1,200})[）)][ \\t]*$",
      "replaceString": "$1",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "格式·心理行转斜体",
      "findRegex": "^[ \\t]*\\{([^}\\n]{1,200})\\}[ \\t]*$",
      "replaceString": "*$1*",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "格式·旁白行去方括号",
      "findRegex": "^[ \\t]*【(?!沈昭宁|苏念|温以宁|周牧|程越|你|我|用户|旁白|环境|叙述|场景|状态|状态卡|/状态)([^】\\n]{1,80})】[ \\t]*$",
      "replaceString": "$1",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "格式·旁白前缀去除",
      "findRegex": "^[ \\t]*【(?:旁白|环境|叙述|场景)】[ \\t]*",
      "replaceString": "",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "格式·台词前名字转发言块",
      "findRegex": "^[ \\t]*(沈昭宁|苏念|温以宁|周牧|程越|你)[ \\t]*[：:][ \\t]*",
      "replaceString": "【$1】\n",
      "flags": "gm",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    },
    {
      "scriptName": "格式·压缩空行",
      "findRegex": "\\n{3,}",
      "replaceString": "\n\n",
      "flags": "g",
      "disabled": false,
      "markdownOnly": true,
      "promptOnly": false,
      "placement": [
        2
      ],
      "minDepth": null,
      "maxDepth": null
    }
  ]
}
